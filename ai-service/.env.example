# LLM Provider Configuration ("openai" or "anthropic")
LLM_PROVIDER=openai

# LLM API Keys (set at least one depending on LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
LLM_MODEL=gpt-4o-mini
MAX_TOKENS=2000
TEMPERATURE=0.2

# Internal Microservice Shared Secret (Must match Express server's AI_SERVICE_API_KEY)
AI_SERVICE_API_KEY=reporadar-ai-service-secret-key-change-in-production

# Server Port
PORT=8000
