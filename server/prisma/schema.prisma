// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Models
model User {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String       @unique
  password            String?      // Nullable for OAuth users
  github_id           Int?
  github_username     String?
  github_access_token String?      // Encrypted AES-256 string
  repositories        Repository[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Repository {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  user_id              String               @db.ObjectId
  github_repo_id       Int                  @unique
  github_repo_name     String
  github_repo_fullname String
  github_repo_url      String
  description          String?
  stars                Int                  @default(0)
  language             String?
  is_selected          Boolean              @default(false)
  last_synced_at       DateTime?
  metrics              RepositoryMetrics?
  languages            RepositoryLanguage[]
  commits              RepositoryCommit[]
  files                RepositoryFile[]
  fileTree             RepositoryFileTree?
  codeIssues           CodeIssue[]
  analysisSummary      AnalysisSummary?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user                 User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model CodeIssue {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  repository_id   String     @db.ObjectId
  file_path       String
  line_number     Int
  column_number   Int?
  issue_type      String     // "security" | "performance" | "bug" | "code-smell" | "maintainability"
  severity        String     // "critical" | "high" | "medium" | "low"
  message         String
  suggested_fix   String?
  code_snippet    String?
  rule_id         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  repository      Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)

  @@index([repository_id])
  @@index([repository_id, severity])
  @@index([repository_id, issue_type])
}

model AnalysisSummary {
  id                        String     @id @default(auto()) @map("_id") @db.ObjectId
  repository_id             String     @unique @db.ObjectId
  total_issues              Int        @default(0)
  critical_count            Int        @default(0)
  high_count                Int        @default(0)
  medium_count              Int        @default(0)
  low_count                 Int        @default(0)
  security_issues_count     Int        @default(0)
  performance_issues_count  Int        @default(0)
  bug_issues_count          Int        @default(0)
  code_smell_count          Int        @default(0)
  maintainability_count     Int        @default(0)
  analysis_completed_at     DateTime?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  repository                Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)
}

model RepositoryFile {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  repository_id   String     @db.ObjectId
  file_path       String
  file_type       String
  file_size       Int
  language        String?
  content         String?
  is_binary       Boolean    @default(false)
  last_fetched_at DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  repository      Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)

  @@unique([repository_id, file_path])
  @@index([repository_id])
}

model RepositoryFileTree {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  repository_id String     @unique @db.ObjectId
  tree_json     String
  total_files   Int        @default(0)
  total_dirs    Int        @default(0)
  updated_at    DateTime   @updatedAt

  repository    Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)
}

model RepositoryMetrics {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  repository_id     String     @unique @db.ObjectId
  stars_count       Int        @default(0)
  forks_count       Int        @default(0)
  open_issues_count Int        @default(0)
  open_prs_count    Int        @default(0)
  default_branch    String?
  total_commits     Int?
  last_commit_date  DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  repository        Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)
}

model RepositoryLanguage {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  repository_id String     @db.ObjectId
  language      String
  bytes         Int
  percentage    Float
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  repository    Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)

  @@index([repository_id])
}

model RepositoryCommit {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  repository_id String     @db.ObjectId
  commit_sha    String
  author        String
  message       String
  committed_at  DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  repository    Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)

  @@unique([repository_id, commit_sha])
  @@index([repository_id])
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
