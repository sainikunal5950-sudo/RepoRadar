# Database Connection (MongoDB Atlas free tier or local MongoDB)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reporadar?retryWrites=true&w=majority"

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:3000"

# NextAuth Shared Secret (for token verification in Module 2)
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# GitHub OAuth Credentials (for Module 2)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
