# Database Connection (MongoDB Atlas free tier or local MongoDB)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/reporadar?retryWrites=true&w=majority"

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:3000"

# JWT Secret & NextAuth Shared Secret (Must match client's NEXTAUTH_SECRET)
JWT_SECRET="reporadar-super-secret-key-change-in-production"
NEXTAUTH_SECRET="reporadar-super-secret-key-change-in-production"

# AES-256 Token Encryption Key (Generate via openssl rand -hex 16)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# GitHub OAuth Credentials (for Module 3)
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# Developer Analytics Configuration (Module 9)
MAX_COMMITS_TO_SYNC=500
COMMIT_SYNC_BATCH_SIZE=20
